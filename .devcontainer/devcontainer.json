{
  "name": "JFrog Workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "remoteEnv": {
    "JFROG_URL": "${containerEnv:JFROG_URL}",
    "JFROG_ACCESS_TOKEN": "${containerEnv:JFROG_ACCESS_TOKEN}",
    "JFROG_SERVER_ID": "workshop",
    "JF_PROJECT": "${containerEnv:JF_PROJECT}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "chat.plugins.enabled": true,
        "chat.useHooks": true,
        "chat.plugins.marketplaces": [
          "https://github.com/jfrog/vscode-plugin/"
        ]
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-jfrog-plugin.sh"
}
